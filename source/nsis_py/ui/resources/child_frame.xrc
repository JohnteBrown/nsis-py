<?xml version="1.0" encoding="utf-8"?>
<resource xmlns="http://www.wxwidgets.org/wxxmlres">
  <object class="wxFrame" name="ChildWindow">
	<title>Child Window</title>
	<size>300,200</size>
	<object class="wxPanel" name="child_panel">
	  <object class="wxBoxSizer">
		<orient>wxVERTICAL</orient>
		<object class="sizeritem">
		  <object class="wxStaticText" name="child_label">
			<label>Settings Window</label>
		  </object>
		  <flag>wxALL</flag>
		  <border>10</border>
		</object>
	  </object>
	</object>
  </object>
</resource>
